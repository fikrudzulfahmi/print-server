# Nama antrian (harus sama dengan yang dipakai client .bat)
QUEUE_RAW=EpsonL120
QUEUE_PS=EpsonL120-PS
DEFAULT_QUEUE=EpsonL120

# URI printer; kosong = cari otomatis lewat `lpinfo -v` (usb://EPSON...)
PRINTER_URI=

# Nama server yang diumumkan ke client (dipakai di dokumentasi/banner)
SERVER_NAME=NGEMIS-AI
